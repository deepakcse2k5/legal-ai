# --- Model: choose one ---------------------------------------------------
# Cloudflare Workers AI (recommended for the hosted site; needs a token with "Workers AI" permission)
LLM_PROVIDER=cloudflare
CF_ACCOUNT_ID=your-account-id
CF_API_TOKEN=your-workers-ai-token
# CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Semantic search on top of keyword search (uses the same Cloudflare credentials; set to "none" to disable)
EMBEDDINGS=cloudflare

# Local model through Ollama (private, runs on your machine)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b
# EMBEDDINGS=none

# Hosted model through Groq
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-key
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Access -------------------------------------------------------------
# If set, callers must send this value in the X-API-Key header (the website Worker and legal-ui do).
API_KEY=change-me-to-a-long-random-string
# Only needed if a browser app calls the API directly
CORS_ORIGINS=http://localhost:8501
